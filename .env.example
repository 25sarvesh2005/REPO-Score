# ==============================================================================
# RepoScore Application Environment Configuration Example
# Copy this file to .env and adjust variables as needed for local development.
# DO NOT COMMIT SENSITIVE PRODUCTION CREDENTIALS.
# ==============================================================================

# Application & Environment
APP_NAME=RepoScore
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# API Gateway
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Relational Datastore
DATABASE_URL=postgresql+asyncpg://reposcore_user:reposcore_pass@localhost:5432/reposcore_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis Distributed Job Queue & Pub/Sub
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Evaluation Limits & Timeouts
EVALUATION_DEFAULT_TIMEOUT_SECONDS=600
EVALUATION_MAX_TIMEOUT_SECONDS=1800
SNAPSHOT_STORAGE_PATH=/var/reposcore/snapshots

# Rate Limiting & Abuse Prevention
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# Sandbox Security & Resource Quotas
SANDBOX_DEFAULT_IMAGE_PYTHON=reposcore/sandbox-python:3.11-slim
SANDBOX_DEFAULT_IMAGE_NODE=reposcore/sandbox-node:20-slim
SANDBOX_MAX_MEMORY_MB=2048
SANDBOX_MAX_CPUS=2.0
SANDBOX_MAX_PIDS=128

# AI Auxiliary Provider (Local Ollama Default)
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL_NAME=llama3.2:3b
AI_TEMPERATURE=0.1
AI_TIMEOUT_SECONDS=60
